# ---------------------------------------------------------------------------
# Northstar RAG assistant configuration
# Copy to .env and fill in the provider you want to use.
# ---------------------------------------------------------------------------

# LLM provider: auto | deepseek | openai | ollama | custom | offline
# "auto" uses DeepSeek, then OpenAI, then the offline extractive fallback.
LLM_PROVIDER=auto

# Provider API keys. Only one is needed. DEEPSEEK_API_KEY takes priority in auto.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Generic overrides for OpenAI-compatible endpoints (vLLM, LiteLLM, OpenRouter...).
# LLM_API_KEY=
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=my-model

# Ollama Cloud runs inference on Ollama servers, not this computer.
# Set LLM_PROVIDER=ollama-cloud and add an API key from https://ollama.com/settings/keys.
# LLM_PROVIDER=ollama-cloud
# OLLAMA_API_KEY=
# LLM_MODEL=gemma4:31b

# Optional model override. Defaults: deepseek-chat, gpt-4o-mini, llama3.2.
# LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=700

# Local CPU models can take longer than a cloud API; 180s is a safe default
# for the Ollama setup documented in the README.
LLM_TIMEOUT_SECONDS=180

# For a fully local, zero-API-cost setup:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2:3b

# Embeddings: auto | sentence-transformers | hash
# auto uses Sentence Transformers when installed, otherwise deterministic hashing.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store: auto | chroma | sqlite
# auto uses Chroma when installed, otherwise a persistent SQLite store.
VECTOR_BACKEND=auto
COLLECTION_NAME=northstar_docs

# Chunking / retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
RETRIEVAL_CANDIDATES=12

# Paths are resolved relative to the repository root when not absolute.
# DATA_DIR=data/sample_docs
# VECTOR_DIR=vector_store

LOG_LEVEL=INFO

# Optional request tracing (install requirements-observability.txt first).
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=northstar-rag-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
