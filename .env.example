# ---------------------------------------------------------------------------
# Northstar RAG assistant configuration
# Copy to .env and fill in the provider you want to use.
# ---------------------------------------------------------------------------

# LLM provider: auto | deepseek | openai | ollama | custom | offline
# "auto" uses DeepSeek, then OpenAI, then the offline extractive fallback.
LLM_PROVIDER=auto

# Provider API keys. Only one is needed. DEEPSEEK_API_KEY takes priority in auto.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Generic overrides for OpenAI-compatible endpoints (vLLM, LiteLLM, OpenRouter...).
# LLM_API_KEY=
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=my-model

# Optional model override. Defaults: deepseek-chat, gpt-4o-mini, llama3.2.
# LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=700

# Embeddings: auto | sentence-transformers | hash
# auto uses Sentence Transformers when installed, otherwise deterministic hashing.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store: auto | chroma | sqlite
# auto uses Chroma when installed, otherwise a persistent SQLite store.
VECTOR_BACKEND=auto
COLLECTION_NAME=northstar_docs

# Chunking / retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
RETRIEVAL_CANDIDATES=12

# Paths are resolved relative to the repository root when not absolute.
# DATA_DIR=data/sample_docs
# VECTOR_DIR=vector_store

LOG_LEVEL=INFO
